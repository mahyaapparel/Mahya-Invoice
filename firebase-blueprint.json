{
  "entities": {
    "orders": {
      "title": "Orders",
      "description": "Convection orders for invoice and production tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerAddress": { "type": "string" },
        "productType": { "type": "string" },
        "fabricType": { "type": "string" },
        "fabricColor": { "type": "string" },
        "sablonBordir": { "type": "string" },
        "quantityTotal": { "type": "number" },
        "sizeDistribution": { "type": "string" },
        "unitPrice": { "type": "number" },
        "totalPrice": { "type": "number" },
        "dpAmount": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "productionStatus": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "customerName", "totalPrice", "createdAt"]
    },
    "customers": {
      "title": "Customers",
      "description": "Customer contact list and notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "settings": {
      "title": "Settings",
      "description": "Kasir & Invoice settings",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "slogan": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "additionalNotes": { "type": "string" }
      },
      "required": ["businessName"]
    },
    "transactions": {
      "title": "Finance Transactions",
      "description": "Financial income and expense records synced to Financial Dashboard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "division": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "paymentType": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "date", "division", "type", "amount", "description"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/orders" },
      "description": "Convection orders collection"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/customers" },
      "description": "Customers collection"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/settings" },
      "description": "Kasir settings collection"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/transactions" },
      "description": "Finance transactions collection"
    }
  }
}
